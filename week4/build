touch project4_solution.py && rm project4_solution.py

printf "Grading project4\n"

jupyter-nbconvert --to python project4_solution.ipynb \
  --PythonExporter.exclude_markdown=True \
  --TagRemovePreprocessor.remove_cell_tags notebook_only \
  > /dev/null 2> /dev/null

