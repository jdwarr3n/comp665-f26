touch project5_solution.py && rm project5_solution.py

printf "Grading project5\n"

jupyter-nbconvert --to python project5_solution.ipynb \
  --PythonExporter.exclude_markdown=True \
  --TagRemovePreprocessor.remove_cell_tags notebook_only \
  > /dev/null 2> /dev/null

