touch project9_solution.py && rm project9_solution.py

printf "Grading project9\n"

jupyter-nbconvert --to python project9_solution.ipynb \
  --PythonExporter.exclude_markdown=True \
  --TagRemovePreprocessor.remove_cell_tags notebook_only \
  > /dev/null 2> /dev/null

